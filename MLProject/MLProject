name: Japanese_Universities_Classification

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path: {type: str, default: "data_clean.csv"}
      n_estimators: {type: int, default: 200}
      max_depth: {type: int, default: 20}
      min_samples_split: {type: int, default: 10}
    command: "python modelling.py --data_path={data_path} --n_estimators={n_estimators} --max_depth={max_depth} --min_samples_split={min_samples_split}"